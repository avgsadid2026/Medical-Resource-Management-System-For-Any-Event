# Server configuration
NODE_ENV=development
PORT=4000

# PostgreSQL connection string (replace user, password, host, port, and db name)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/emrms_db?schema=public"

# Session & CSRF secrets (generate long random strings for real deployments)
SESSION_SECRET="replace-with-a-long-random-session-secret-at-least-32-chars"
CSRF_SECRET="replace-with-a-long-random-csrf-secret-at-least-32-chars"

# Allowed frontend origin for CORS + session cookies
FRONTEND_ORIGIN="http://localhost:5173"
